        "text_iAEdVM": {
          "type": "text",
          "settings": {
            "text": "<h2>My engineering philosophy is simple: write scalable code, optimize for Core Web Vitals, and build infrastructure that empowers marketing teams to move faster. Having transitioned into development from a background in enterprise tech sales almost 10 years ago, I approach every Jira ticket and codebase refactor with a strict focus on business impact and ROI. I don't just build features; <strong>I engineer solutions that increase conversions and reduce operational bottlenecks.</strong><br/><br/>I am looking for a role where I can take lead of a storefront's technical roadmap, streamline development operations, and directly impact the bottom line.&nbsp;</h2>"
          }
        }
      },
      "block_order": [

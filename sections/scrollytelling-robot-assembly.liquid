<!-- Load Lenis, GSAP & ScrollTrigger from CDN if not already loaded -->
<script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const sectionSelector = '#ScrollyRobot-' + sectionId;

    function ensureLenisSmoothScroll() {
      if (window.__tnLenisInstance || typeof Lenis === 'undefined' || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        return;
      }
      const lenis = new Lenis({
        lerp: 0.08,
        wheelMultiplier: 0.95,
        smoothWheel: true,
        syncTouch: false
      });
      window.__tnLenisInstance = lenis;
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(function(time) {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
    }

    function initScrollyRobot() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined' || typeof Lenis === 'undefined') {
        setTimeout(initScrollyRobot, 50);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      ensureLenisSmoothScroll();

      const sectionEl = document.querySelector(sectionSelector);
      if (!sectionEl) return;

      ScrollTrigger.getAll().forEach((st) => {
        if (st.vars && st.vars.id === 'scrolly-robot-' + sectionId) {
          st.kill();
        }
      });

      const introHeader = sectionEl.querySelector('[data-intro-header]');
      const progressFill = sectionEl.querySelector('[data-progress-fill]');
      const statusReadout = sectionEl.querySelector('[data-status-readout]');
      const textBlock = sectionEl.querySelector('[data-typography-block]');

      // Scattered starting vectors for the 6 blueprint schematic sub-assemblies
      const scatteredVectors = {
        'cranial-sensor': { x: -360, y: -220, rotation: -125, scale: 1.35, opacity: 0.35 },
        'thoracic-cage':  { x: 380,  y: -170, rotation: 85,   scale: 0.65, opacity: 0.4  },
        'reactor-gyro':   { x: 440,  y: 40,   rotation: 220,  scale: 1.95, opacity: 0.35 },
        'left-actuator':  { x: -460, y: 110,  rotation: -160, scale: 1.25, opacity: 0.4  },
        'right-actuator': { x: 460,  y: 210,  rotation: 155,  scale: 1.25, opacity: 0.4  },
        'bipedal-frame':  { x: -280, y: 290,  rotation: 110,  scale: 0.72, opacity: 0.38 }
      };

      Object.keys(scatteredVectors).forEach((partKey) => {
        const el = sectionEl.querySelector('[data-part="' + partKey + '"]');
        if (el) {
          gsap.set(el, scatteredVectors[partKey]);
        }
      });

      if (introHeader) {
        gsap.set(introHeader, { opacity: 1, y: 0 });
      }

      gsap.set(textBlock, {
        xPercent: 130,
        opacity: 0
      });

      const tl = gsap.timeline({
        scrollTrigger: {
          id: 'scrolly-robot-' + sectionId,
          trigger: sectionEl,
          pin: true,
          pinSpacing: true,
          start: 'top top',
          end: '+=2600',
          scrub: 1.2,
          anticipatePin: 1,
          onUpdate: (self) => {
            if (progressFill) {
              gsap.set(progressFill, { scaleX: self.progress });
            }

            if (self.progress >= 0.95) {
              if (!sectionEl.classList.contains('is-assembled')) {
                sectionEl.classList.add('is-assembled');
                if (statusReadout) statusReadout.textContent = 'BLUEPRINT: LOCKED // PULSE ACTIVE';
              }
            } else {
              if (sectionEl.classList.contains('is-assembled')) {
                sectionEl.classList.remove('is-assembled');
              }
              if (statusReadout) {
                statusReadout.textContent = self.progress > 0.02
                  ? 'ALIGNING CAD VECTORS (' + Math.round(self.progress * 100) + '%)'
                  : 'SCHEMATIC: UNINDEXED';
              }
            }
          }
        }
      });

      // 1. Fade out flat 2D "SCROLL DOWN ▼ ▼ ▼" intro header as user begins scrolling
      if (introHeader) {
        tl.to(introHeader, {
          opacity: 0,
          y: -28,
          ease: 'power2.out',
          duration: 0.22
        }, 0);
      }

      // 2. Translate, scale & rotate schematic modules into centralized blueprint alignment
      Object.keys(scatteredVectors).forEach((partKey, index) => {
        const el = sectionEl.querySelector('[data-part="' + partKey + '"]');
        if (el) {
          tl.to(el, {
            x: 0,
            y: 0,
            rotation: 0,
            scale: 1,
            opacity: 1,
            ease: 'power3.out',
            duration: 0.95
          }, index * 0.035);
        }
      });

      // 3. Synchronized horizontal slide-in of the typography block
      tl.to(textBlock, {
        xPercent: 0,
        opacity: 1,
        ease: 'power2.out',
        duration: 0.72
      }, 0.35);

      // Hold final locked blueprint state briefly at end of scrub
      tl.to({}, { duration: 0.15 });
    }

    document.addEventListener('DOMContentLoaded', initScrollyRobot);
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        initScrollyRobot();
      }
    });
  })();
</script>


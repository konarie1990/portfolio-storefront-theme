            <circle cx="304" cy="119" r="4.5" fill="#9ece6a"/>
            <text x="326" y="123" fill="#c0caf5" font-size="11" font-weight="bold" font-family="monospace">ACME-ROBOTICS.MYSHOPIFY.COM</text>
            <!-- Cart Pill -->
            <rect x="588" y="110" width="44" height="18" rx="4" fill="#7aa2f7"/>
            <text x="596" y="123" fill="#16161e" font-size="10" font-weight="bold" font-family="monospace">CART</text>
          </g>

          <!-- Storefront Hero Banner -->
          <g class="storefront-module" data-ui-part="hero">
            <rect x="258" y="146" width="384" height="64" rx="6" fill="#24283b" stroke="#bb9af7" stroke-width="1.5"/>
            <text x="274" y="172" fill="#7dcfff" font-size="13" font-weight="bold" font-family="monospace">NEXT-GEN CYBERNETIC COMMERCE</text>
            <text x="274" y="193" fill="#c0caf5" font-size="10" font-family="monospace">Forged via Agentic Liquid Architecture // Ready to Ship</text>
            <rect x="562" y="164" width="66" height="26" rx="4" fill="#bb9af7"/>
            <text x="573" y="181" fill="#16161e" font-size="10" font-weight="bold" font-family="monospace">EXPLORE</text>

          <!-- Inner CRT Glass Screen -->
          <rect x="244" y="88" width="412" height="292" rx="14" fill="url(#sf-screen-glow-{{ section.id }})" stroke="#7dcfff" stroke-width="2.5"/>

          <!-- Monitor Power LED & Retro Branding Bar -->
          <circle cx="636" cy="398" r="5" fill="#9ece6a"/>
          <rect x="255" y="394" width="60" height="8" rx="3" fill="#7aa2f7" opacity="0.5"/>
        </g>

        <!-- LAYER 4: DIGITAL E-COMMERCE STOREFRONT UI (Assembles inside the CRT screen) -->
        <g data-storefront-ui>
          <!-- Storefront Top Browser / Nav Header -->
          <g class="storefront-module" data-ui-part="header">
            <rect x="258" y="102" width="384" height="34" rx="6" fill="#16161e" stroke="#7aa2f7" stroke-width="1.5"/>
            <circle cx="274" cy="119" r="4.5" fill="#f7768e"/>

{% comment %}
  Section 2: Scrollytelling Digital Storefront (Tokyo Night Edition)
  Description: Pinned GSAP ScrollTrigger section that routes chaotic motherboard circuits & floating code streams into a retro CRT monitor displaying an e-commerce storefront, with a dynamic floating "Forge" Tag.
{% endcomment %}

{%- style -%}
  #ScrollyStorefront-{{ section.id }} {
    --tn-bg: {{ section.settings.bg_color | default: '#1a1b26' }};
    --tn-bg-dark: {{ section.settings.bg_dark_color | default: '#16161e' }};
    --tn-fg: {{ section.settings.text_color | default: '#c0caf5' }};
    --tn-blue: {{ section.settings.accent_blue | default: '#7aa2f7' }};
    --tn-purple: {{ section.settings.accent_purple | default: '#bb9af7' }};
    --tn-cyan: {{ section.settings.accent_cyan | default: '#7dcfff' }};
    --tn-green: #9ece6a;
    --tn-red: #f7768e;
    --sticky-header-offset: 98px;

    position: relative;
    box-sizing: border-box;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: radial-gradient(circle at 50% 45%, var(--tn-bg) 0%, var(--tn-bg-dark) 100%);
    color: var(--tn-fg);
    padding-top: calc(var(--sticky-header-offset) + {{ section.settings.padding_top }}px);
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    user-select: none;
  }

  /* Subtle Matrix / Circuit Dot Backdrop */
  #ScrollyStorefront-{{ section.id }} .sf-backdrop {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(125, 207, 255, 0.14) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.95) 25%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.95) 25%, transparent 85%);
    pointer-events: none;
    z-index: 1;
  }

  /* CRT Scanline Overlay */
  #ScrollyStorefront-{{ section.id }} .sf-crt-scanlines {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(22, 22, 30, 0) 50%, 
      rgba(22, 22, 30, 0.35) 50%
    );
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 10;
    opacity: 0.4;
  }

  /* Floating Aesthetic "Forge" Tag + Dynamic 4-Corner Positioning */
  #ScrollyStorefront-{{ section.id }} .sf-forge-tag {
    position: absolute;
    z-index: 8;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.95rem;
    background: rgba(22, 22, 30, 0.85);
    border: 1px solid rgba(187, 154, 247, 0.45);
    border-radius: 999px;
    color: var(--tn-cyan);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 0 20px rgba(187, 154, 247, 0.2), inset 0 0 8px rgba(125, 207, 255, 0.1);
    pointer-events: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  #ScrollyStorefront-{{ section.id }} .sf-forge-tag-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tn-green);
    box-shadow: 0 0 8px var(--tn-green);
    animation: sfForgePulse-{{ section.id }} 2s ease-in-out infinite;
  }

  @keyframes sfForgePulse-{{ section.id }} {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.8); }
  }

  #ScrollyStorefront-{{ section.id }} .sf-forge-tag--top-left {
    top: calc(var(--sticky-header-offset) + 3.5rem);
    left: 2.5rem;
  }

  #ScrollyStorefront-{{ section.id }} .sf-forge-tag--top-right {
    top: calc(var(--sticky-header-offset) + 3.5rem);
    right: 2.5rem;
  }

  #ScrollyStorefront-{{ section.id }} .sf-forge-tag--bottom-left {
    bottom: 2.5rem;
    left: 2.5rem;
  }

  #ScrollyStorefront-{{ section.id }} .sf-forge-tag--bottom-right {
    bottom: 2.5rem;
    right: 2.5rem;
  }

  /* Top Telemetry HUD */
  #ScrollyStorefront-{{ section.id }} .sf-hud-bar {
    position: absolute;
    top: calc(var(--sticky-header-offset) + 1rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(88vw, 1100px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tn-purple);
    z-index: 6;
    opacity: 0.85;
  }

  #ScrollyStorefront-{{ section.id }} .sf-progress-track {
    flex: 1;
    height: 2px;
    margin: 0 1.25rem;
    background: rgba(192, 202, 245, 0.12);
    position: relative;
    overflow: hidden;
  }

  #ScrollyStorefront-{{ section.id }} .sf-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--tn-purple), var(--tn-cyan), var(--tn-green));
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* Main Stage & SVG Canvas */
  #ScrollyStorefront-{{ section.id }} .sf-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  #ScrollyStorefront-{{ section.id }} .sf-canvas-wrap {
    position: relative;
    width: min(92vw, 900px);
    height: min(68vh, 560px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: filter 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #ScrollyStorefront-{{ section.id }} .sf-main-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  #ScrollyStorefront-{{ section.id }} .circuit-trace {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    will-change: stroke-dashoffset, opacity, transform;
  }

  #ScrollyStorefront-{{ section.id }} .code-stream,
  #ScrollyStorefront-{{ section.id }} .storefront-module,
  #ScrollyStorefront-{{ section.id }} .monitor-rig {
    will-change: transform, opacity;
    transform-origin: center center;
  }

  /* Final State Lock: Neon Monitor Glow & Live Checkout Pulse */
  #ScrollyStorefront-{{ section.id }}.is-live .sf-canvas-wrap {
    filter:
      drop-shadow(0 0 16px rgba(125, 207, 255, 0.55))
      drop-shadow(0 0 38px rgba(122, 162, 247, 0.45))
      drop-shadow(0 0 70px rgba(187, 154, 247, 0.35));
  }

  #ScrollyStorefront-{{ section.id }}.is-live .sf-buy-btn {
    fill: var(--tn-green);
    filter: drop-shadow(0 0 10px var(--tn-green));
  }

  #ScrollyStorefront-{{ section.id }}.is-live .sf-forge-tag {
    border-color: var(--tn-green);
    box-shadow: 0 0 24px rgba(158, 206, 106, 0.35);
  }

  /* Bottom Caption / Storefront Headline */
  #ScrollyStorefront-{{ section.id }} .sf-caption-box {
    margin-top: 1rem;
    text-align: center;
    max-width: 680px;
    padding: 0 1.25rem;
    z-index: 5;
  }

  #ScrollyStorefront-{{ section.id }} .sf-caption-title {
    margin: 0;
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    color: var(--tn-fg);
    letter-spacing: 0.02em;
  }

  #ScrollyStorefront-{{ section.id }}.is-live .sf-caption-title {
    color: var(--tn-cyan);
    text-shadow: -1px 0 var(--tn-red), 1px 0 var(--tn-blue), 0 0 12px var(--tn-cyan);
  }

  @media screen and (max-width: 768px) {
    #ScrollyStorefront-{{ section.id }} {
      --sticky-header-offset: 65px;
    }

    #ScrollyStorefront-{{ section.id }} .sf-forge-tag--top-left,
    #ScrollyStorefront-{{ section.id }} .sf-forge-tag--top-right {
      top: calc(var(--sticky-header-offset) + 2.75rem);
    }

    #ScrollyStorefront-{{ section.id }} .sf-forge-tag--bottom-left,
    #ScrollyStorefront-{{ section.id }} .sf-forge-tag--bottom-right {
      bottom: 1.25rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign forge_pos_class = 'sf-forge-tag--top-right'
  case section.settings.forge_tag_position
    when 'top_left'
      assign forge_pos_class = 'sf-forge-tag--top-left'
    when 'top_right'
      assign forge_pos_class = 'sf-forge-tag--top-right'
    when 'bottom_left'
      assign forge_pos_class = 'sf-forge-tag--bottom-left'
    when 'bottom_right'
      assign forge_pos_class = 'sf-forge-tag--bottom-right'
  endcase
-%}

<section id="ScrollyStorefront-{{ section.id }}" class="scrolly-storefront-section" data-section-id="{{ section.id }}">
  <div class="sf-backdrop"></div>
  <div class="sf-crt-scanlines"></div>

  <!-- Top Telemetry Bar -->
  <div class="sf-hud-bar">
    <span>BUS.MOTHERBOARD // LIQUID-DOM</span>
    <div class="sf-progress-track">
      <div class="sf-progress-fill" data-progress-fill></div>
    </div>
    <span data-status-readout>BUS: RAW CIRCUITS</span>
  </div>

  <!-- Floating Aesthetic "Forge" Tag -->
  {%- if section.settings.forge_tag_text != blank -%}
    <div class="sf-forge-tag {{ forge_pos_class }}">
      <span class="sf-forge-tag-dot"></span>
      <span>{{ section.settings.forge_tag_text | escape }}</span>
    </div>
  {%- endif -%}

  <!-- Pinned Stage -->
  <div class="sf-stage">
    <div class="sf-canvas-wrap">
      <svg class="sf-main-svg" viewBox="0 0 900 540" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Motherboard Circuits Transforming into Digital Storefront">
        <defs>
          <linearGradient id="sf-crt-bezel-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#24283b"/>
            <stop offset="100%" stop-color="#16161e"/>
          </linearGradient>
          <linearGradient id="sf-screen-glow-{{ section.id }}" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#1a1b26"/>
            <stop offset="100%" stop-color="#13141c"/>
          </linearGradient>
        </defs>

        <!-- LAYER 1: MOTHERBOARD CIRCUIT TRACES (Route inward to CRT Bus) -->
        <g data-circuits-layer>
          <!-- Left Bus Traces -->
          <path class="circuit-trace" data-trace="1" d="M 20 80 H 140 L 195 135 H 275" stroke="#7dcfff" stroke-width="3"/>
          <circle class="circuit-node" cx="20" cy="80" r="5" fill="#7dcfff"/>
          <path class="circuit-trace" data-trace="2" d="M 10 240 H 120 L 170 200 H 255" stroke="#bb9af7" stroke-width="2.5"/>
          <circle class="circuit-node" cx="10" cy="240" r="5" fill="#bb9af7"/>
          <path class="circuit-trace" data-trace="3" d="M 35 420 H 150 L 205 340 H 275" stroke="#7aa2f7" stroke-width="3"/>
          <circle class="circuit-node" cx="35" cy="420" r="5" fill="#7aa2f7"/>

          <!-- Right Bus Traces -->
          <path class="circuit-trace" data-trace="4" d="M 880 95 H 760 L 705 150 H 625" stroke="#7dcfff" stroke-width="3"/>
          <circle class="circuit-node" cx="880" cy="95" r="5" fill="#7dcfff"/>
          <path class="circuit-trace" data-trace="5" d="M 890 265 H 775 L 725 225 H 645" stroke="#9ece6a" stroke-width="2.5"/>
          <circle class="circuit-node" cx="890" cy="265" r="5" fill="#9ece6a"/>
          <path class="circuit-trace" data-trace="6" d="M 865 430 H 740 L 690 355 H 625" stroke="#bb9af7" stroke-width="3"/>
          <circle class="circuit-node" cx="865" cy="430" r="5" fill="#bb9af7"/>

          <!-- Top & Bottom IC Pins -->
          <path class="circuit-trace" data-trace="7" d="M 350 15 V 60 L 380 85" stroke="#7aa2f7" stroke-width="2"/>
          <path class="circuit-trace" data-trace="8" d="M 550 15 V 60 L 520 85" stroke="#7dcfff" stroke-width="2"/>
        </g>

        <!-- LAYER 2: FLOATING STREAMS OF COMPUTER CODE (Converge into Monitor Core) -->
        <g data-code-streams>
          <g class="code-stream" data-code="stream-1">
            <rect x="40" y="110" width="175" height="44" rx="4" fill="#16161e" stroke="#7dcfff" stroke-width="1.5"/>
            <text x="52" y="129" fill="#7dcfff" font-size="11" font-family="monospace">01001100 01001001</text>
            <text x="52" y="145" fill="#bb9af7" font-size="11" font-family="monospace">{% raw %}{{ product.title }}{% endraw %}</text>
          </g>

          <g class="code-stream" data-code="stream-2">
            <rect x="685" y="115" width="180" height="44" rx="4" fill="#16161e" stroke="#bb9af7" stroke-width="1.5"/>
            <text x="697" y="134" fill="#9ece6a" font-size="11" font-family="monospace">POST /cart/add.js</text>
            <text x="697" y="150" fill="#c0caf5" font-size="11" font-family="monospace">status: 200 OK</text>
          </g>

          <g class="code-stream" data-code="stream-3">
            <rect x="30" y="310" width="185" height="44" rx="4" fill="#16161e" stroke="#7aa2f7" stroke-width="1.5"/>
            <text x="42" y="329" fill="#7aa2f7" font-size="11" font-family="monospace">const schema = {</text>
            <text x="42" y="345" fill="#7dcfff" font-size="11" font-family="monospace">  mode: "agentic"</text>
          </g>

          <g class="code-stream" data-code="stream-4">
            <rect x="685" y="315" width="185" height="44" rx="4" fill="#16161e" stroke="#9ece6a" stroke-width="1.5"/>
            <text x="697" y="334" fill="#f7768e" font-size="11" font-family="monospace">&lt;shopify-section&gt;</text>
            <text x="697" y="350" fill="#9ece6a" font-size="11" font-family="monospace">  hydrateStorefront()</text>
          </g>

          <g class="code-stream" data-code="stream-5">
            <rect x="355" y="12" width="190" height="36" rx="4" fill="#16161e" stroke="#7dcfff" stroke-width="1.5"/>
            <text x="368" y="34" fill="#7dcfff" font-size="11" font-family="monospace">0x7AA2F7 // TOKYO_NIGHT</text>
          </g>
        </g>

        <!-- LAYER 3: RETRO COMPUTER MONITOR CHASSIS -->
        <g class="monitor-rig" data-monitor-rig>
          <!-- Monitor Pedestal & Swivel Base -->
          <path d="M 380 415 L 355 468 H 545 L 520 415 Z" fill="url(#sf-crt-bezel-{{ section.id }})" stroke="#7aa2f7" stroke-width="3"/>
          <rect x="315" y="468" width="270" height="18" rx="6" fill="#16161e" stroke="#7dcfff" stroke-width="2.5"/>


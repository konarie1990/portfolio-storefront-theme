          <!-- Product Card 1 -->
          <g class="storefront-module" data-ui-part="card-1">
            <rect x="258" y="220" width="120" height="146" rx="6" fill="#16161e" stroke="#7aa2f7" stroke-width="1.5"/>
            <rect x="268" y="230" width="100" height="58" rx="4" fill="#1a1b26" stroke="#7dcfff" stroke-width="1"/>
            <circle cx="318" cy="259" r="16" stroke="#7dcfff" stroke-width="2"/>
            <text x="268" y="306" fill="#c0caf5" font-size="10" font-weight="bold" font-family="monospace">OPTIC VISOR X1</text>
            <text x="268" y="321" fill="#7dcfff" font-size="10" font-family="monospace">$420.00</text>
            <rect class="sf-buy-btn" x="268" y="332" width="100" height="22" rx="4" fill="#7aa2f7"/>
            <text x="292" y="347" fill="#16161e" font-size="9.5" font-weight="bold" font-family="monospace">ADD +</text>
          </g>

          <!-- Product Card 2 -->
          <g class="storefront-module" data-ui-part="card-2">
            <rect x="390" y="220" width="120" height="146" rx="6" fill="#16161e" stroke="#bb9af7" stroke-width="1.5"/>
            <rect x="400" y="230" width="100" height="58" rx="4" fill="#1a1b26" stroke="#bb9af7" stroke-width="1"/>
            <polygon points="450,242 468,274 432,274" stroke="#bb9af7" stroke-width="2" fill="none"/>
            <text x="400" y="306" fill="#c0caf5" font-size="10" font-weight="bold" font-family="monospace">NEURAL CORE V4</text>
            <text x="400" y="321" fill="#bb9af7" font-size="10" font-family="monospace">$890.00</text>
            <rect class="sf-buy-btn" x="400" y="332" width="100" height="22" rx="4" fill="#7dcfff"/>
            <text x="424" y="347" fill="#16161e" font-size="9.5" font-weight="bold" font-family="monospace">ADD +</text>
          </g>

          <!-- Product Card 3 -->
          <g class="storefront-module" data-ui-part="card-3">
            <rect x="522" y="220" width="120" height="146" rx="6" fill="#16161e" stroke="#7dcfff" stroke-width="1.5"/>

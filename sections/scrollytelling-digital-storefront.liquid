    </div>

    <div class="sf-caption-box">
      <h2 class="sf-caption-title">{{ section.settings.headline_text }}</h2>
    </div>
  </div>
</section>

<!-- Load Lenis, GSAP & ScrollTrigger from CDN if not already loaded -->
<script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const sectionSelector = '#ScrollyStorefront-' + sectionId;

    function ensureLenisSmoothScroll() {
      if (window.__tnLenisInstance || typeof Lenis === 'undefined' || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        return;
      }
      const lenis = new Lenis({
        lerp: 0.08,
        wheelMultiplier: 0.95,
        smoothWheel: true,
        syncTouch: false
      });
      window.__tnLenisInstance = lenis;
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(function(time) {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
    }

    function initScrollyStorefront() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined' || typeof Lenis === 'undefined') {
        setTimeout(initScrollyStorefront, 50);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      ensureLenisSmoothScroll();

      const sectionEl = document.querySelector(sectionSelector);
      if (!sectionEl) return;

      ScrollTrigger.getAll().forEach((st) => {
        if (st.vars && st.vars.id === 'scrolly-storefront-' + sectionId) {
          st.kill();
        }
      });

      const progressFill = sectionEl.querySelector('[data-progress-fill]');
      const statusReadout = sectionEl.querySelector('[data-status-readout]');
      const monitorRig = sectionEl.querySelector('[data-monitor-rig]');
      const traces = sectionEl.querySelectorAll('.circuit-trace');

      // Prepare SVG circuit traces for stroke-dashoffset routing
      traces.forEach((trace) => {
        const length = trace.getTotalLength ? trace.getTotalLength() : 300;
        gsap.set(trace, {
          strokeDasharray: length,
          strokeDashoffset: 0,
          opacity: 1
        });
      });

      // Initial Chaotic Positions for Floating Code Streams (filling the viewport)
      const initialCodeVectors = {
        'stream-1': { x: -90,  y: -50, rotation: -18, scale: 1.35, opacity: 1 },
        'stream-2': { x: 85,   y: -60, rotation: 22,  scale: 1.3,  opacity: 1 },
        'stream-3': { x: -110, y: 70,  rotation: 15,  scale: 1.4,  opacity: 1 },
        'stream-4': { x: 95,   y: 80,  rotation: -20, scale: 1.35, opacity: 1 },
        'stream-5': { x: 0,    y: -45, rotation: 8,   scale: 1.45, opacity: 1 }
      };

      Object.keys(initialCodeVectors).forEach((key) => {
        const el = sectionEl.querySelector('[data-code="' + key + '"]');
        if (el) {
          gsap.set(el, initialCodeVectors[key]);
        }
      });

      // Monitor starts deconstructed / scaled down in background
      gsap.set(monitorRig, {
        scale: 0.72,
        opacity: 0.15,
        y: 40
      });

      // Storefront UI modules start scattered & uncompiled
      const uiStartVectors = {
        'header': { y: -120, scale: 0.6, opacity: 0 },
        'hero':   { x: -160, scale: 0.7, opacity: 0 },
        'card-1': { x: -180, y: 140, rotation: -25, scale: 0.5, opacity: 0 },
        'card-2': { y: 180,  rotation: 18,  scale: 0.5, opacity: 0 },
        'card-3': { x: 180,  y: 140, rotation: 25,  scale: 0.5, opacity: 0 }
      };

      Object.keys(uiStartVectors).forEach((uiKey) => {
        const el = sectionEl.querySelector('[data-ui-part="' + uiKey + '"]');
        if (el) {
          gsap.set(el, uiStartVectors[uiKey]);
        }
      });

      // Create Pinned Scrubbing Timeline with standard pinSpacing and numeric scrub (1.2)
      const tl = gsap.timeline({
        scrollTrigger: {
          id: 'scrolly-storefront-' + sectionId,
          trigger: sectionEl,
          pin: true,
          pinSpacing: true,
          start: 'top top',
          end: '+=2600',
          scrub: 1.2,
          anticipatePin: 1,
          onUpdate: (self) => {
            if (progressFill) {
              gsap.set(progressFill, { scaleX: self.progress });
            }

            if (self.progress >= 0.95) {
              if (!sectionEl.classList.contains('is-live')) {
                sectionEl.classList.add('is-live');
                if (statusReadout) statusReadout.textContent = 'STOREFRONT: LIVE // 200 OK';
              }
            } else {
              if (sectionEl.classList.contains('is-live')) {
                sectionEl.classList.remove('is-live');
              }
              if (statusReadout) {
                statusReadout.textContent = self.progress > 0.03
                  ? 'COMPILING DOM (' + Math.round(self.progress * 100) + '%)'
                  : 'BUS: RAW CIRCUITS';
              }
            }
          }
        }
      });

      // Phase 1: Route & pulse circuit traces inward while materializing the Retro CRT Monitor
      tl.to(monitorRig, {
        scale: 1,
        opacity: 1,
        y: 0,
        ease: 'power3.out',
        duration: 0.55
      }, 0);

      // Phase 2: Route floating code streams directly into the CRT screen center and compile them
      const codeTargets = {
        'stream-1': { x: 260,  y: 80,  rotation: 0, scale: 0.35, opacity: 0 },
        'stream-2': { x: -260, y: 80,  rotation: 0, scale: 0.35, opacity: 0 },
        'stream-3': { x: 260,  y: -80, rotation: 0, scale: 0.35, opacity: 0 },
        'stream-4': { x: -260, y: -80, rotation: 0, scale: 0.35, opacity: 0 },
        'stream-5': { x: 0,    y: 190, rotation: 0, scale: 0.35, opacity: 0 }
      };

      Object.keys(codeTargets).forEach((key, idx) => {
        const el = sectionEl.querySelector('[data-code="' + key + '"]');
        if (el) {
          tl.to(el, {
            x: codeTargets[key].x,
            y: codeTargets[key].y,
            rotation: 0,
            scale: codeTargets[key].scale,
            opacity: 0,
            ease: 'power2.inOut',
            duration: 0.65
          }, idx * 0.04);
        }
      });

      // Retract outer circuit traces cleanly into the monitor bus
      traces.forEach((trace, idx) => {
        const length = trace.getTotalLength ? trace.getTotalLength() : 300;
        tl.to(trace, {
          strokeDashoffset: -length * 0.65,
          opacity: 0.35,
          ease: 'power2.inOut',
          duration: 0.7
        }, 0.1 + idx * 0.02);
      });

      // Phase 3: Assemble Digital E-Commerce Storefront UI inside the CRT Monitor
      Object.keys(uiStartVectors).forEach((uiKey, idx) => {
        const el = sectionEl.querySelector('[data-ui-part="' + uiKey + '"]');
        if (el) {
          tl.to(el, {
            x: 0,
            y: 0,
            rotation: 0,
            scale: 1,
            opacity: 1,
            ease: 'back.out(1.3)',
            duration: 0.55
          }, 0.38 + idx * 0.08);
        }
      });

      tl.to({}, { duration: 0.15 });
    }

    document.addEventListener('DOMContentLoaded', initScrollyStorefront);
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        initScrollyStorefront();
      }
    });
  })();
</script>


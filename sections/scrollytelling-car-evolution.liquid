{% comment %}
  Section 4: The Outrun Morph (80s to Synthwave Future - Rear-Chase Camera Perspective)
  Description:
    - Rear-chase (tail-view) synthwave composition in the Tokyo Night palette.
    - Scrubs a high-altitude standard sun down into a horizon-hugging sliced neon synthwave sun.
    - Stretches & crossfades flanking 80s vector trees into towering neon skyscrapers, and sharpens basic hills into geometric neon-grid mountains.
    - Fades in a 3D perspective highway grid that rushes toward the camera.
    - Evolves a rear-view 80s boxy coupe into a wide-body cyber-supercar with cyan/magenta thruster trails.
    - Positions the caption container completely below the SVG artwork container with a baseline CRT pulse + vanilla JS random 2-3 letter failing-neon-sign flicker.
{% endcomment %}

{%- style -%}
  #OutrunMorph-{{ section.id }} {
    --tn-bg: {{ section.settings.bg_color | default: '#1a1b26' }};
    --tn-bg-dark: {{ section.settings.bg_dark_color | default: '#16161e' }};
    --tn-fg: {{ section.settings.text_color | default: '#c0caf5' }};
    --tn-blue: {{ section.settings.accent_blue | default: '#7aa2f7' }};
    --tn-purple: {{ section.settings.accent_purple | default: '#bb9af7' }};
    --tn-cyan: {{ section.settings.accent_cyan | default: '#7dcfff' }};
    --tn-green: #9ece6a;
    --tn-red: #f7768e;
    --sticky-header-offset: 98px;

    position: relative;
    box-sizing: border-box;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: radial-gradient(circle at 50% 38%, var(--tn-bg) 0%, var(--tn-bg-dark) 100%);
    color: var(--tn-fg);
    padding-top: calc(var(--sticky-header-offset) + {{ section.settings.padding_top }}px);
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  @media screen and (max-width: 768px) {
    #OutrunMorph-{{ section.id }} {
      --sticky-header-offset: 65px;
    }
  }

  /* CRT Scanline Overlay */
  #OutrunMorph-{{ section.id }} .om-crt-scanlines {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(22, 22, 30, 0) 50%, 
      rgba(22, 22, 30, 0.36) 50%
    );
    background-size: 100% 4px;
    pointer-events: none;
    z-index: 10;
    opacity: 0.42;
  }

  /* Top Telemetry Bar */
  #OutrunMorph-{{ section.id }} .om-hud-bar {
    position: relative;
    width: min(92vw, 1140px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--tn-cyan);
    margin-bottom: 0.65rem;
    z-index: 6;
    opacity: 0.88;
  }

  #OutrunMorph-{{ section.id }} .om-progress-track {
    flex: 1;
    height: 2px;
    margin: 0 1.25rem;
    background: rgba(192, 202, 245, 0.14);
    position: relative;
    overflow: hidden;
  }

  #OutrunMorph-{{ section.id }} .om-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, var(--tn-blue), var(--tn-purple), var(--tn-red), var(--tn-cyan));
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* Main Framed Synthwave Artwork Container */
  #OutrunMorph-{{ section.id }} .om-artwork-container {
    position: relative;
    width: min(92vw, 1140px);
    height: min(66vh, 580px);
    border-radius: 10px;
    border: 1px solid rgba(122, 162, 247, 0.28);
    background: var(--tn-bg-dark);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.75),
      0 0 30px rgba(122, 162, 247, 0.12);
    overflow: hidden;
    z-index: 3;
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  #OutrunMorph-{{ section.id }}.is-synthwave .om-artwork-container {
    border-color: var(--tn-cyan);
    box-shadow:
      0 20px 65px rgba(0, 0, 0, 0.85),
      0 0 32px rgba(125, 207, 255, 0.35),
      0 0 70px rgba(187, 154, 247, 0.28);
  }

  #OutrunMorph-{{ section.id }} .om-scene-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Continuous Forward Motion Animation on the 3D Ground Grid Horizontal Lines */
  #OutrunMorph-{{ section.id }} .om-grid-scroll-lines {
    animation: omGridRush-{{ section.id }} 1.1s linear infinite;
    will-change: transform;
  }

  @keyframes omGridRush-{{ section.id }} {
    0% {
      transform: translateY(0px);
    }
    100% {
      transform: translateY(28px);
    }
  }

  /* Post-Transform Neon Glow Filters on Supercar & Sun */
  #OutrunMorph-{{ section.id }} .om-neon-sun-group {
    filter: drop-shadow(0 0 28px rgba(247, 118, 142, 0.65)) drop-shadow(0 0 55px rgba(187, 154, 247, 0.45));
  }

  #OutrunMorph-{{ section.id }} .om-future-car-group {
    filter: drop-shadow(0 0 14px rgba(125, 207, 255, 0.55)) drop-shadow(0 0 30px rgba(247, 118, 142, 0.45));
  }

  #OutrunMorph-{{ section.id }}.is-synthwave .om-future-car-group {
    animation: omSupercarPulse-{{ section.id }} 2.2s ease-in-out infinite;
  }

  @keyframes omSupercarPulse-{{ section.id }} {
    0%, 100% {
      filter:
        drop-shadow(0 0 14px rgba(125, 207, 255, 0.75))
        drop-shadow(0 0 34px rgba(247, 118, 142, 0.65));
    }
    50% {
      filter:
        drop-shadow(0 0 24px rgba(125, 207, 255, 1))
        drop-shadow(0 0 52px rgba(187, 154, 247, 0.9));
    }
  }

  /* ==========================================================================
     TYPOGRAPHY CONTAINER (POSITIONED COMPLETELY BELOW THE SVG ARTWORK CONTAINER)
     + Baseline CRT Pulse + Random 2-3 Letter Failing-Neon-Sign Flicker
     ========================================================================== */
  #OutrunMorph-{{ section.id }} .om-typography-dock {
    position: relative;
    width: min(92vw, 1140px);
    margin-top: 1.35rem;
    padding: 0.5rem 1rem;
    text-align: center;
    z-index: 5;
  }

  /* Baseline Subtle CRT Pulse on Entire Text Block */
  #OutrunMorph-{{ section.id }} .om-caption-heading {
    margin: 0;
    font-size: clamp(1.75rem, 4.2vw, 3.35rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tn-fg);
    line-height: 1.15;
    animation: omBaselineCrtPulse-{{ section.id }} 3s ease-in-out infinite;
    will-change: text-shadow, opacity;
  }

  @keyframes omBaselineCrtPulse-{{ section.id }} {
    0%, 100% {
      opacity: 0.95;
      text-shadow:
        -1px 0 rgba(247, 118, 142, 0.45),
        1px 0 rgba(122, 162, 247, 0.45),
        0 0 14px rgba(192, 202, 245, 0.25);
    }
    50% {
      opacity: 1;
      text-shadow:
        -1.5px 0 rgba(247, 118, 142, 0.7),
        1.5px 0 rgba(125, 207, 255, 0.7),
        0 0 24px rgba(187, 154, 247, 0.5);
    }
  }

  /* Severe, Erratic Failing-Neon-Sign Flicker on Randomly Selected .glitch-letter Spans */
  #OutrunMorph-{{ section.id }} .om-caption-heading .glitch-letter {
    display: inline-block;
    color: var(--tn-cyan);
    animation: omFailingNeonFlicker-{{ section.id }} 1.25s steps(2, start) infinite;
    will-change: opacity, transform, text-shadow, color;
  }

  #OutrunMorph-{{ section.id }} .om-caption-heading .glitch-letter:nth-of-type(2n) {
    animation-duration: 0.88s;
    animation-delay: -0.4s;
  }

  #OutrunMorph-{{ section.id }} .om-caption-heading .glitch-letter:nth-of-type(3n) {
    animation-duration: 1.55s;
    animation-delay: -0.75s;
  }

  @keyframes omFailingNeonFlicker-{{ section.id }} {
    0%, 100% {
      opacity: 1;
      color: var(--tn-cyan);
      text-shadow:
        -2px 0 var(--tn-red),
        2px 0 var(--tn-blue),
        0 0 12px var(--tn-cyan),
        0 0 28px var(--tn-cyan),
        0 0 48px var(--tn-purple);
      transform: translate(0, 0) skewX(0deg);
    }
    8% {
      opacity: 0.06;
      color: #3b4261;
      text-shadow: none;
      transform: translate(-1px, 1px) skewX(-7deg);
    }
    14% {
      opacity: 0.95;
      color: var(--tn-red);
      text-shadow:
        3px 0 var(--tn-cyan),
        -3px 0 var(--tn-purple),
        0 0 22px var(--tn-red);
      transform: translate(1px, -1px) skewX(5deg);
    }
    21% {
      opacity: 0.12;
      color: #3b4261;
      text-shadow: none;
      transform: translate(0, 0);
    }
    28%, 50% {
      opacity: 1;
      color: var(--tn-cyan);
      text-shadow:
        0 0 10px var(--tn-cyan),
        0 0 24px var(--tn-blue);
      transform: translate(0, 0);
    }
    55% {
      opacity: 0.18;
      color: var(--tn-purple);
      text-shadow: -3px 0 var(--tn-red), 3px 0 var(--tn-cyan);
      transform: translate(-2px, 0) skewX(-5deg);
    }
    61% {
      opacity: 0.04;
      text-shadow: none;
    }
    67%, 86% {
      opacity: 1;
      color: #ffffff;
      text-shadow:
        -2px 0 var(--tn-red),
        2px 0 var(--tn-cyan),
        0 0 18px var(--tn-cyan),
        0 0 38px var(--tn-purple);
      transform: translate(1px, 0) skewX(3deg);
    }
    92% {
      opacity: 0.28;
      color: var(--tn-cyan);
      text-shadow: 0 0 6px var(--tn-blue);
      transform: translate(0, 1px);
    }
  }
{%- endstyle -%}

<section id="OutrunMorph-{{ section.id }}" class="outrun-morph-section" data-section-id="{{ section.id }}">
  <div class="om-crt-scanlines"></div>

  <!-- Top Telemetry Bar -->
  <div class="om-hud-bar">
    <span>OUTRUN.SYNTH // REAR-CHASE CAM</span>
    <div class="om-progress-track">
      <div class="om-progress-fill" data-progress-fill></div>
    </div>
    <span data-status-readout>ERA: 1984 HIGHWAY // ANALOG</span>
  </div>

  <!-- MAIN LAYERED SVG ARTWORK CONTAINER (Rear-Chase Tail-View Perspective) -->
  <div class="om-artwork-container">
    <svg
      class="om-scene-svg"
      viewBox="0 0 1200 620"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="80s to Synthwave Future Outrun Rear-Chase Scene"
    >
      <defs>
        <!-- Sky Gradients -->
        <linearGradient id="om-sky-base-{{ section.id }}" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#16161e"/>
          <stop offset="60%" stop-color="#1a1b26"/>
          <stop offset="100%" stop-color="#24283b"/>
        </linearGradient>

        <linearGradient id="om-sky-synth-{{ section.id }}" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#16161e"/>
          <stop offset="45%" stop-color="#1f1d36"/>
          <stop offset="82%" stop-color="#432356"/>
          <stop offset="100%" stop-color="#f7768e" stop-opacity="0.55"/>
        </linearGradient>

        <!-- Sliced Neon Synthwave Sun Gradient -->
        <linearGradient id="om-neon-sun-grad-{{ section.id }}" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#7dcfff"/>
          <stop offset="30%" stop-color="#bb9af7"/>
          <stop offset="70%" stop-color="#f7768e"/>
          <stop offset="100%" stop-color="#ff9e64"/>
        </linearGradient>

        <!-- Mask for Horizontal Sliced Synthwave Sun -->
        <mask id="om-sun-slices-{{ section.id }}">
          <rect x="350" y="60" width="500" height="400" fill="white"/>
          <rect x="350" y="252" width="500" height="5" fill="black"/>
          <rect x="350" y="270" width="500" height="7" fill="black"/>
          <rect x="350" y="290" width="500" height="9" fill="black"/>
          <rect x="350" y="312" width="500" height="12" fill="black"/>
          <rect x="350" y="336" width="500" height="15" fill="black"/>
          <rect x="350" y="362" width="500" height="19" fill="black"/>
        </mask>

        <!-- Clip Path for Ground Plane (Y: 360 -> 620) -->
        <clipPath id="om-ground-clip-{{ section.id }}">
          <rect x="0" y="360" width="1200" height="260"/>
        </clipPath>

        <!-- Clip Path for Sky Plane (Y: 0 -> 360) -->
        <clipPath id="om-sky-clip-{{ section.id }}">
          <rect x="0" y="0" width="1200" height="360"/>
        </clipPath>

        <!-- Linear Gradients for Cyber Supercar -->
        <linearGradient id="om-cyber-chassis-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#16161e"/>
          <stop offset="50%" stop-color="#24283b"/>
          <stop offset="100%" stop-color="#16161e"/>
        </linearGradient>

        <linearGradient id="om-thruster-cyan-{{ section.id }}" x1="50%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="35%" stop-color="#7dcfff"/>
          <stop offset="100%" stop-color="#7dcfff" stop-opacity="0"/>
        </linearGradient>

        <linearGradient id="om-thruster-magenta-{{ section.id }}" x1="50%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="35%" stop-color="#f7768e"/>
          <stop offset="100%" stop-color="#bb9af7" stop-opacity="0"/>
        </linearGradient>
      </defs>

      <!-- ==================================================================
           1. SKY & SUN LAYER (Clipped to Horizon Y=360)
           ================================================================== -->
      <g clip-path="url(#om-sky-clip-{{ section.id }})">
        <!-- Base 80s Night Sky -->
        <rect x="0" y="0" width="1200" height="360" fill="url(#om-sky-base-{{ section.id }})"/>
        <!-- Synthwave Horizon Glow Sky (Crossfades in) -->
        <rect data-synth-sky x="0" y="0" width="1200" height="360" fill="url(#om-sky-synth-{{ section.id }})" opacity="0"/>

        <!-- Starfield -->
        <g opacity="0.65">
          <circle cx="140" cy="58" r="1.5" fill="#c0caf5"/>
          <circle cx="290" cy="95" r="1" fill="#7dcfff"/>
          <circle cx="440" cy="44" r="1.5" fill="#bb9af7"/>
          <circle cx="780" cy="52" r="1.5" fill="#c0caf5"/>
          <circle cx="950" cy="88" r="2" fill="#7dcfff"/>
          <circle cx="1080" cy="40" r="1.5" fill="#f7768e"/>
        </g>

        <!-- THE SUN: Starts high in the sky as a standard solid sun, lowers to horizon & transitions to sliced neon sun -->
        <g data-sun-wrapper>
          <!-- Standard 80s Solid Sun (High in sky) -->
          <circle
            data-standard-sun
            cx="600"
            cy="115"
            r="68"
            fill="#e0af68"
            opacity="0.9"
          />

          <!-- Sliced Neon Synthwave Sun (Revealed as sun lowers to horizon) -->
          <g class="om-neon-sun-group" data-neon-sun opacity="0">
            <circle
              cx="600"
              cy="255"
              r="138"
              fill="url(#om-neon-sun-grad-{{ section.id }})"
              mask="url(#om-sun-slices-{{ section.id }})"
            />
          </g>
        </g>

        <!-- ================================================================
             2. LANDSCAPE LAYER: MOUNTAINS & TREES -> SKYSCRAPERS
             ================================================================ -->
        <!-- Initial 80s Basic Low Hills (Soft muted silhouettes) -->
        <g data-basic-mountains>
          <polygon points="0,360 0,295 160,245 330,310 490,275 560,360" fill="#1f2335" stroke="#3b4261" stroke-width="2"/>
          <polygon points="640,360 720,270 880,305 1040,240 1200,295 1200,360" fill="#1f2335" stroke="#3b4261" stroke-width="2"/>
        </g>

        <!-- Transformed Synthwave Sharp Geometric Neon-Outlined Peaks -->
        <g data-neon-mountains opacity="0">
          <!-- Left Sharp Peaks -->
          <polygon points="40,360 195,180 335,360" fill="#16161e" stroke="#7dcfff" stroke-width="2.5"/>
          <polyline points="195,180 225,275 145,320" stroke="#bb9af7" stroke-width="1.5" fill="none"/>
          <polygon points="230,360 365,205 495,360" fill="#1a1b26" stroke="#bb9af7" stroke-width="2.5"/>
          <polyline points="365,205 390,290 320,335" stroke="#7dcfff" stroke-width="1.5" fill="none"/>
          <polygon points="-20,360 95,220 215,360" fill="#16161e" stroke="#7aa2f7" stroke-width="2"/>

          <!-- Right Sharp Peaks -->
          <polygon points="705,360 835,205 970,360" fill="#1a1b26" stroke="#bb9af7" stroke-width="2.5"/>
          <polyline points="835,205 810,290 880,335" stroke="#7dcfff" stroke-width="1.5" fill="none"/>
          <polygon points="865,360 1005,180 1160,360" fill="#16161e" stroke="#7dcfff" stroke-width="2.5"/>
          <polyline points="1005,180 975,275 1055,320" stroke="#bb9af7" stroke-width="1.5" fill="none"/>
          <polygon points="985,360 1105,220 1220,360" fill="#16161e" stroke="#7aa2f7" stroke-width="2"/>
        </g>

        <!-- Initial 80s Simple Vector Trees (Flanking Left & Right along Horizon) -->
        <g data-basic-trees>
          <!-- Left Trees -->
          <g transform="translate(55, 290)">
            <rect x="16" y="45" width="6" height="25" fill="#3b4261"/>
            <polygon points="19,0 0,32 38,32" fill="#292e42" stroke="#7aa2f7" stroke-width="1.5"/>
            <polygon points="19,16 -4,50 42,50" fill="#24283b" stroke="#7aa2f7" stroke-width="1.5"/>
          </g>
          <g transform="translate(135, 302)">
            <rect x="13" y="36" width="5" height="22" fill="#3b4261"/>
            <polygon points="15,0 0,26 30,26" fill="#292e42" stroke="#7aa2f7" stroke-width="1.5"/>
            <polygon points="15,14 -3,40 33,40" fill="#24283b" stroke="#7aa2f7" stroke-width="1.5"/>
          </g>
          <g transform="translate(210, 310)">
            <rect x="11" y="30" width="4" height="20" fill="#3b4261"/>
            <polygon points="13,0 0,22 26,22" fill="#292e42" stroke="#7aa2f7" stroke-width="1.5"/>
            <polygon points="13,12 -2,34 28,34" fill="#24283b" stroke="#7aa2f7" stroke-width="1.5"/>
          </g>

          <!-- Right Trees -->
          <g transform="translate(960, 310)">
            <rect x="11" y="30" width="4" height="20" fill="#3b4261"/>
            <polygon points="13,0 0,22 26,22" fill="#292e42" stroke="#7aa2f7" stroke-width="1.5"/>
            <polygon points="13,12 -2,34 28,34" fill="#24283b" stroke="#7aa2f7" stroke-width="1.5"/>
          </g>
          <g transform="translate(1030, 302)">
            <rect x="13" y="36" width="5" height="22" fill="#3b4261"/>
            <polygon points="15,0 0,26 30,26" fill="#292e42" stroke="#7aa2f7" stroke-width="1.5"/>
            <polygon points="15,14 -3,40 33,40" fill="#24283b" stroke="#7aa2f7" stroke-width="1.5"/>
          </g>
          <g transform="translate(1105, 290)">
            <rect x="16" y="45" width="6" height="25" fill="#3b4261"/>
            <polygon points="19,0 0,32 38,32" fill="#292e42" stroke="#7aa2f7" stroke-width="1.5"/>
            <polygon points="19,16 -4,50 42,50" fill="#24283b" stroke="#7aa2f7" stroke-width="1.5"/>
          </g>
        </g>

        <!-- Transformed Towering Cityscape Skyscrapers (Flanking Left & Right) -->
        <g data-skyscrapers opacity="0">
          <!-- Left Metropolis Cluster -->
          <rect x="18" y="135" width="48" height="225" fill="#16161e" stroke="#7dcfff" stroke-width="2"/>
          <line x1="42" y1="95" x2="42" y2="135" stroke="#f7768e" stroke-width="2.5"/>
          <circle cx="42" cy="95" r="3.5" fill="#f7768e"/>
          <rect x="26" y="150" width="32" height="6" fill="#7dcfff" opacity="0.8"/>
          <rect x="26" y="168" width="32" height="6" fill="#bb9af7" opacity="0.8"/>
          <rect x="26" y="186" width="32" height="6" fill="#7dcfff" opacity="0.8"/>
          <rect x="26" y="204" width="32" height="6" fill="#7aa2f7" opacity="0.8"/>

          <rect x="74" y="170" width="54" height="190" fill="#1a1b26" stroke="#bb9af7" stroke-width="2"/>
          <rect x="84" y="185" width="12" height="150" fill="#7dcfff" opacity="0.45"/>
          <rect x="104" y="185" width="12" height="150" fill="#f7768e" opacity="0.45"/>

          <rect x="136" y="205" width="44" height="155" fill="#16161e" stroke="#7aa2f7" stroke-width="2"/>
          <rect x="145" y="220" width="26" height="4" fill="#9ece6a"/>
          <rect x="145" y="236" width="26" height="4" fill="#7dcfff"/>
          <rect x="145" y="252" width="26" height="4" fill="#bb9af7"/>

          <rect x="188" y="240" width="38" height="120" fill="#16161e" stroke="#7dcfff" stroke-width="1.5"/>

          <!-- Right Metropolis Cluster -->
          <rect x="974" y="240" width="38" height="120" fill="#16161e" stroke="#7dcfff" stroke-width="1.5"/>

          <rect x="1020" y="205" width="44" height="155" fill="#16161e" stroke="#7aa2f7" stroke-width="2"/>
          <rect x="1029" y="220" width="26" height="4" fill="#bb9af7"/>
          <rect x="1029" y="236" width="26" height="4" fill="#7dcfff"/>
          <rect x="1029" y="252" width="26" height="4" fill="#9ece6a"/>

          <rect x="1072" y="170" width="54" height="190" fill="#1a1b26" stroke="#bb9af7" stroke-width="2"/>
          <rect x="1084" y="185" width="12" height="150" fill="#f7768e" opacity="0.45"/>
          <rect x="1104" y="185" width="12" height="150" fill="#7dcfff" opacity="0.45"/>

          <rect x="1134" y="135" width="48" height="225" fill="#16161e" stroke="#7dcfff" stroke-width="2"/>
          <line x1="1158" y1="95" x2="1158" y2="135" stroke="#f7768e" stroke-width="2.5"/>
          <circle cx="1158" cy="95" r="3.5" fill="#f7768e"/>
          <rect x="1142" y="150" width="32" height="6" fill="#7dcfff" opacity="0.8"/>
          <rect x="1142" y="168" width="32" height="6" fill="#bb9af7" opacity="0.8"/>
          <rect x="1142" y="186" width="32" height="6" fill="#7dcfff" opacity="0.8"/>
          <rect x="1142" y="204" width="32" height="6" fill="#7aa2f7" opacity="0.8"/>
        </g>
      </g>

      <!-- ==================================================================
           3. GROUND & 3D PERSPECTIVE NEON GRID LAYER (Y: 360 -> 620)
           ================================================================== -->

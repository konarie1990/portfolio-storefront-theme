<!-- Load Lenis, GSAP & ScrollTrigger from CDN if not already loaded -->
<script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const sectionSelector = '#OutrunMorph-' + sectionId;

    function ensureLenisSmoothScroll() {
      if (window.__tnLenisInstance || typeof Lenis === 'undefined' || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        return;
      }
      const lenis = new Lenis({
        lerp: 0.08,
        wheelMultiplier: 0.95,
        smoothWheel: true,
        syncTouch: false
      });
      window.__tnLenisInstance = lenis;
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(function(time) {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
    }

    /**
     * Vanilla JS Utility: Splits the caption text string and randomly wraps
     * 2 or 3 non-whitespace letters in <span class="glitch-letter"> so they
     * receive the severe, erratic failing-neon-sign flicker while the parent
     * heading block maintains its subtle baseline CRT pulse.
     */
    function applySelectiveLetterFlicker(headingEl) {
      if (!headingEl) return;
      const rawText = headingEl.getAttribute('data-caption-heading') || headingEl.textContent.trim();
      const chars = Array.from(rawText);

      const eligibleIndices = [];
      chars.forEach((ch, idx) => {
        if (ch.trim().length > 0) {
          eligibleIndices.push(idx);
        }
      });

      // Shuffle eligible indices (Fisher-Yates)
      for (let i = eligibleIndices.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const temp = eligibleIndices[i];
        eligibleIndices[i] = eligibleIndices[j];
        eligibleIndices[j] = temp;
      }

      const targetCount = Math.min(eligibleIndices.length, Math.random() < 0.5 ? 2 : 3);
      const selectedSet = new Set(eligibleIndices.slice(0, targetCount));

      headingEl.innerHTML = chars
        .map((ch, idx) => {
          const escaped = ch
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
          if (selectedSet.has(idx)) {
            return '<span class="glitch-letter">' + escaped + '</span>';
          }
          return escaped;
        })
        .join('');
    }

    function initOutrunMorph() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined' || typeof Lenis === 'undefined') {
        setTimeout(initOutrunMorph, 50);
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      ensureLenisSmoothScroll();

      const sectionEl = document.querySelector(sectionSelector);
      if (!sectionEl) return;

      // Clean up existing ScrollTrigger instances on Shopify Theme Editor re-renders
      ScrollTrigger.getAll().forEach((st) => {
        if (st.vars && st.vars.id === 'outrun-morph-' + sectionId) {
          st.kill();
        }
      });

      const headingEl = sectionEl.querySelector('[data-caption-heading]');
      applySelectiveLetterFlicker(headingEl);

      // Scene Elements
      const synthSky = sectionEl.querySelector('[data-synth-sky]');
      const standardSun = sectionEl.querySelector('[data-standard-sun]');
      const neonSun = sectionEl.querySelector('[data-neon-sun]');
      const basicMountains = sectionEl.querySelector('[data-basic-mountains]');
      const neonMountains = sectionEl.querySelector('[data-neon-mountains]');
      const basicTrees = sectionEl.querySelector('[data-basic-trees]');
      const skyscrapers = sectionEl.querySelector('[data-skyscrapers]');
      const basicRoad = sectionEl.querySelector('[data-basic-road]');
      const neonGrid = sectionEl.querySelector('[data-neon-grid]');
      const retroCar = sectionEl.querySelector('[data-retro-car]');
      const futureCar = sectionEl.querySelector('[data-future-car]');
      const thrusterTrails = sectionEl.querySelector('[data-thruster-trails]');
      const progressFill = sectionEl.querySelector('[data-progress-fill]');
      const statusReadout = sectionEl.querySelector('[data-status-readout]');

      // Initial States (1980s Scene)
      gsap.set(synthSky, { opacity: 0 });
      gsap.set(standardSun, { y: 0, scale: 1, opacity: 0.9 });
      gsap.set(neonSun, { y: -110, scale: 0.55, opacity: 0, transformOrigin: '600px 255px' });

      gsap.set(basicMountains, { scaleY: 1, opacity: 1, transformOrigin: '600px 360px' });
      gsap.set(neonMountains, { scaleY: 0.35, scaleX: 1.12, opacity: 0, transformOrigin: '600px 360px' });

      gsap.set(basicTrees, { scaleY: 1, opacity: 1, transformOrigin: '600px 360px' });
      gsap.set(skyscrapers, { scaleY: 0.2, opacity: 0, transformOrigin: '600px 360px' });

      gsap.set(basicRoad, { opacity: 1 });
      gsap.set(neonGrid, { opacity: 0, scaleY: 0.85, transformOrigin: '600px 360px' });

      gsap.set(retroCar, { scale: 1, y: 0, opacity: 1, transformOrigin: '600px 480px' });
      gsap.set(futureCar, { scale: 0.82, y: 24, opacity: 0, transformOrigin: '600px 480px' });
      gsap.set(thrusterTrails, { scaleY: 0.2, opacity: 0, transformOrigin: '600px 502px' });

      const tl = gsap.timeline({
        scrollTrigger: {
          id: 'outrun-morph-' + sectionId,
          trigger: sectionEl,
          pin: true,
          pinSpacing: true,
          start: 'top top',
          end: '+=2600',
          scrub: 1.2,
          anticipatePin: 1,
          onUpdate: (self) => {
            if (progressFill) {
              gsap.set(progressFill, { scaleX: self.progress });
            }

            if (self.progress >= 0.88) {
              sectionEl.classList.add('is-synthwave');
              if (statusReadout) statusReadout.textContent = 'ERA: 2099 SYNTHWAVE // HYPER-GRID ONLINE';
            } else if (self.progress > 0.1) {
              sectionEl.classList.remove('is-synthwave');
              if (statusReadout) statusReadout.textContent = 'MORPHING ENVIRONMENT (' + Math.round(self.progress * 100) + '%)';
            } else {
              sectionEl.classList.remove('is-synthwave');
              if (statusReadout) statusReadout.textContent = 'ERA: 1984 HIGHWAY // ANALOG';
            }
          }
        }
      });

      // 1. THE SUN: Lowers toward the horizon & transitions into sliced glowing neon synthwave sun
      tl.to(standardSun, {
        y: 135,
        scale: 1.85,
        opacity: 0,
        duration: 0.65,
        ease: 'power2.inOut'
      }, 0);

      tl.to(neonSun, {
        y: 0,
        scale: 1,
        opacity: 1,
        duration: 0.75,
        ease: 'power2.out'
      }, 0.12);

      tl.to(synthSky, {
        opacity: 1,
        duration: 0.7,
        ease: 'power1.inOut'
      }, 0.1);

      // 2. THE LANDSCAPE: Trees stretch & morph into skyscrapers; basic hills sharpen & move inward into neon peaks
      tl.to(basicTrees, {
        scaleY: 2.8,
        opacity: 0,
        duration: 0.5,
        ease: 'power2.in'
      }, 0.1);

      tl.to(skyscrapers, {
        scaleY: 1,
        opacity: 1,
        duration: 0.65,
        ease: 'back.out(1.2)'
      }, 0.28);

      tl.to(basicMountains, {
        scaleY: 1.4,
        opacity: 0,
        duration: 0.5,
        ease: 'power2.in'
      }, 0.12);

      tl.to(neonMountains, {
        scaleY: 1,
        scaleX: 1,
        opacity: 1,
        duration: 0.65,
        ease: 'power3.out'
      }, 0.25);

      // 3. THE GROUND: 3D perspective neon grid fades in over the flat ground
      tl.to(basicRoad, {
        opacity: 0,
        duration: 0.45,
        ease: 'power1.out'
      }, 0.2);

      tl.to(neonGrid, {
        opacity: 1,
        scaleY: 1,
        duration: 0.65,
        ease: 'power2.out'
      }, 0.22);

      // 4. THE CAR: Crossfade & scale 80s boxy car into the retro-futuristic cyber sports car + ignite thruster trails
      tl.to(retroCar, {
        scale: 1.08,
        y: 12,
        opacity: 0,
        duration: 0.5,
        ease: 'power2.inOut'
      }, 0.35);

      tl.to(futureCar, {
        scale: 1,
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: 'power3.out'
      }, 0.38);

      tl.to(thrusterTrails, {
        scaleY: 1,
        opacity: 1,
        duration: 0.45,
        ease: 'power2.out'
      }, 0.55);
    }

    document.addEventListener('DOMContentLoaded', initOutrunMorph);
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        initOutrunMorph();
      }
    });
  })();
</script>


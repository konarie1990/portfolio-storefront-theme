</style>

<script>
  (function() {
    function initInteractiveCheckoutArchitecture() {
      const section = document.querySelector('.ica-section[data-section-id="{{ section.id }}"]');
      if (!section) return;

      const toggleControl = section.querySelector('.ica-toggle-control');
      const toggleButtons = section.querySelectorAll('.ica-toggle-btn');
      const businessPanels = section.querySelectorAll('.ica-state-business');
      const technicalPanels = section.querySelectorAll('.ica-state-technical');

      if (!toggleControl || !toggleButtons.length) return;

      function switchView(targetView) {
        // Update control container attribute for slider transition
        toggleControl.setAttribute('data-active-view', targetView);

        // Update button states
        toggleButtons.forEach(btn => {
          const isActive = btn.dataset.targetView === targetView;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        // Switch panels with smooth fade
        if (targetView === 'business') {
          technicalPanels.forEach(p => p.classList.remove('active'));
          businessPanels.forEach(p => p.classList.add('active'));
        } else {
          businessPanels.forEach(p => p.classList.remove('active'));
          technicalPanels.forEach(p => p.classList.add('active'));
        }
      }

      toggleButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          const target = this.dataset.targetView;
          switchView(target);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInteractiveCheckoutArchitecture);
    } else {
      initInteractiveCheckoutArchitecture();
    }

    // Support Shopify Theme Editor dynamic events
    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.contains(document.querySelector('.ica-section[data-section-id="{{ section.id }}"]'))) {
        initInteractiveCheckoutArchitecture();
      }
    });
  })();
</script>

